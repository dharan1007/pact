{
  "$schema": "./schema/pact-manifest.schema.json",
  "schemaVersion": "1.0",
  "name": "PACT",
  "kind": "transactional-webmcp",
  "status": "experimental",
  "webmcp": {
    "hostPreference": ["document.modelContext"],
    "transport": "in-page",
    "toolsOnly": true,
    "requiresSecureContext": true,
    "annotations": ["readOnlyHint", "untrustedContentHint"]
  },
  "http": {
    "connectorModule": "./http.bundle.js",
    "endpoint": "/api/pact",
    "method": "POST",
    "requestEnvelope": { "operation": "string", "payload": "object" },
    "operations": ["inspect", "preview", "approve", "commit", "verify", "receipt", "rollback", "cancel"],
    "idempotencyHeader": "Idempotency-Key",
    "idempotencyRequiredFor": ["commit", "rollback"]
  },
  "adapterContract": {
    "module": "./adapter.bundle.js",
    "schema": "./schema/pact-adapter.schema.json",
    "requiredMethods": ["describe", "plan", "verify"],
    "planModel": "declarative-effects-and-invariants",
    "maxEffects": 256,
    "maxInvariants": 256
  },
  "runtime": {
    "module": "./sdk/runtime.js",
    "adapterDriven": true,
    "approvalVerifierRequired": true,
    "stateModel": "optimistic-versioned",
    "receiptBindsApprovalClaims": true
  },
  "integrations": {
    "externalRuntimeModule": "./sdk/runtime.js",
    "restModule": "./sdk/http.js",
    "requiredMethods": ["read", "plan", "apply", "verify"],
    "remoteRevisionBinding": true,
    "conditionalWriteHeader": "If-Match",
    "idempotencyHeader": "Idempotency-Key",
    "lostResponseRecovery": true,
    "credentialBoundary": "server-side"
  },
  "agentBridges": {
    "module": "./sdk/agent-bridge.js",
    "surfaces": ["http", "webmcp", "mcp"],
    "webmcpHost": "document.modelContext",
    "webmcpUntrustedContentDefault": true,
    "mcpProtocolRevision": "2026-07-28",
    "transportOwnedByHost": true
  },
  "server": {
    "journalModule": "./sdk/journal.js",
    "storeContract": ["get", "create", "compareAndSwap"],
    "crossInstanceClaims": true,
    "persistentIdempotentReplay": true,
    "uncertainCommitRecovery": true,
    "consequentialOperations": ["commit", "rollback"]
  },
  "authority": {
    "module": "./sdk/authority.js",
    "storeModule": "./sdk/redis-store.js",
    "atomicStoreRequired": true,
    "singleUseCommitCapability": true,
    "capabilityBinding": ["txId", "planHash", "baseVersion", "humanPrincipal", "agentSession"],
    "idempotentReplay": "same-key-only",
    "productionStoreRequirement": "durable atomic create and compare-and-swap",
    "productionStore": "Redis-compatible HTTPS REST with atomic SET NX and Lua CAS"
  },
  "referenceRuntime": {
    "module": "./engine.bundle.js",
    "scope": "reference-domain-only",
    "warning": "The reference engine remains for the guided Helios scenario. Real integrations should use ./sdk/runtime.js createPactExternalRuntime with a secure provider integration such as createPactRestIntegration, application-controlled approval verification, and the durable journal/authority primitives behind an authenticated /api/pact service."
  },
  "security": {
    "humanApproval": "application-supplied verifier must validate approval and return humanPrincipal plus agentSession claims",
    "planBinding": "sha256",
    "stateBinding": "canonical version or external provider revision",
    "authority": "opaque short-lived single-use capability bound to transaction, plan, state revision and verified identity claims",
    "providerCredentials": "server-side only; never expose provider secrets to WebMCP/browser agents",
    "externalContent": "WebMCP agent bridge marks remote provider output untrusted by default",
    "verification": "postconditions plus invariants plus adapter/integration verification",
    "receipt": "hash binds integration/adapter, plan, versions or revisions, effects, invariants and approval claims"
  },
  "documentation": {
    "developers": "/developers/",
    "security": "/security/",
    "protocol": "/how-it-works/",
    "playground": "/workspace/",
    "agentBridges": "/docs/agent-bridges.md"
  }
}

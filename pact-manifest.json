{
  "$schema": "./schema/pact-manifest.schema.json",
  "schemaVersion": "1.0",
  "name": "PACT",
  "kind": "transactional-webmcp",
  "status": "experimental",
  "webmcp": {
    "hostPreference": ["document.modelContext"],
    "transport": "in-page",
    "toolsOnly": true,
    "requiresSecureContext": true,
    "annotations": ["readOnlyHint", "untrustedContentHint"]
  },
  "http": {
    "connectorModule": "./http.bundle.js",
    "endpoint": "/api/pact",
    "method": "POST",
    "requestEnvelope": { "operation": "string", "payload": "object" },
    "operations": ["inspect", "preview", "approve", "commit", "verify", "receipt", "rollback", "cancel"],
    "idempotencyHeader": "Idempotency-Key",
    "idempotencyRequiredFor": ["commit", "rollback"]
  },
  "adapterContract": {
    "module": "./adapter.bundle.js",
    "schema": "./schema/pact-adapter.schema.json",
    "requiredMethods": ["describe", "plan", "verify"],
    "planModel": "declarative-effects-and-invariants",
    "maxEffects": 256,
    "maxInvariants": 256
  },
  "runtime": {
    "module": "./sdk/runtime.js",
    "adapterDriven": true,
    "approvalVerifierRequired": true,
    "stateModel": "optimistic-versioned",
    "receiptBindsApprovalClaims": true
  },
  "authority": {
    "module": "./sdk/authority.js",
    "storeModule": "./sdk/redis-store.js",
    "atomicStoreRequired": true,
    "singleUseCommitCapability": true,
    "capabilityBinding": ["txId", "planHash", "baseVersion", "humanPrincipal", "agentSession"],
    "idempotentReplay": "same-key-only",
    "productionStoreRequirement": "durable atomic create and compare-and-swap",
    "productionStore": "Redis-compatible HTTPS REST with atomic SET NX and Lua CAS"
  },
  "durability": {
    "module": "./sdk/durable-state.js",
    "recordModel": "single-versioned-state-plus-journal",
    "atomicity": "compare-and-swap",
    "persistentReplayRecords": true,
    "crashRecovery": "reload-and-validate-journal",
    "concurrency": "single-winner-optimistic-transition"
  },
  "provenance": {
    "endpoint": "/release-provenance.json",
    "integrityManifest": "/release-manifest.json",
    "sourceRepository": "https://github.com/dharan1007/pact"
  },
  "referenceRuntime": {
    "module": "./engine.bundle.js",
    "scope": "reference-domain-only",
    "warning": "The reference engine remains for the guided Helios scenario. New integrations should use ./sdk/runtime.js with a validated adapter, an application-controlled approval verifier, ./sdk/authority.js for commit capabilities, and ./sdk/durable-state.js backed by a durable atomic store for transaction state and replay records."
  },
  "security": {
    "humanApproval": "application-supplied verifier must validate approval and return humanPrincipal plus agentSession claims",
    "planBinding": "sha256",
    "stateBinding": "canonical version",
    "authority": "opaque short-lived single-use capability bound to transaction, plan, base version and verified identity claims",
    "verification": "postconditions plus invariants plus adapter verification",
    "receipt": "hash binds adapter, plan, versions, effects, invariants and approval claims"
  },
  "documentation": {
    "developers": "/developers/",
    "security": "/security/",
    "protocol": "/how-it-works/",
    "playground": "/workspace/"
  }
}

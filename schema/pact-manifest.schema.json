{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-webmcp.vercel.app/schema/pact-manifest.schema.json",
  "title": "PACT Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "kind", "status", "webmcp", "http", "adapterContract", "runtime", "authority", "durability", "integrations", "agentBridges", "provenance", "referenceRuntime", "security", "documentation"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "name": { "const": "PACT" },
    "kind": { "const": "transactional-webmcp" },
    "status": { "enum": ["experimental", "preview", "stable"] },
    "webmcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostPreference", "transport", "toolsOnly", "requiresSecureContext", "annotations", "executeCallback", "registrationAbortSignal", "executionAbortSignal"],
      "properties": {
        "hostPreference": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "transport": { "const": "in-page" },
        "toolsOnly": { "type": "boolean" },
        "requiresSecureContext": { "type": "boolean" },
        "annotations": { "type": "array", "prefixItems": [{ "const": "readOnlyHint" }, { "const": "untrustedContentHint" }], "minItems": 2, "maxItems": 2 },
        "executeCallback": { "const": "single-input" },
        "registrationAbortSignal": { "const": true },
        "executionAbortSignal": { "const": false }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorModule", "handlerModule", "endpoint", "method", "requestEnvelope", "operations", "idempotencyHeader", "idempotencyRequiredFor"],
      "properties": {
        "connectorModule": { "const": "./http.bundle.js" },
        "handlerModule": { "const": "./sdk/http-handler.js" },
        "endpoint": { "const": "/api/pact" },
        "method": { "const": "POST" },
        "requestEnvelope": { "type": "object" },
        "operations": { "type": "array", "prefixItems": [{"const":"inspect"},{"const":"preview"},{"const":"approve"},{"const":"commit"},{"const":"verify"},{"const":"receipt"}], "minItems": 6, "maxItems": 6 },
        "idempotencyHeader": { "const": "Idempotency-Key" },
        "idempotencyRequiredFor": { "type": "array", "prefixItems": [{ "const": "commit" }], "minItems": 1, "maxItems": 1 }
      }
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "schema", "requiredMethods", "planModel", "maxEffects", "maxInvariants"],
      "properties": {
        "module": { "const": "./adapter.bundle.js" },
        "schema": { "const": "./schema/pact-adapter.schema.json" },
        "requiredMethods": { "type": "array", "prefixItems": [{"const":"describe"},{"const":"plan"},{"const":"verify"}], "minItems": 3, "maxItems": 3 },
        "planModel": { "const": "declarative-effects-and-invariants" },
        "maxEffects": { "const": 256 },
        "maxInvariants": { "const": 256 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "serverModule", "adapterDriven", "approvalVerifierRequired", "stateModel", "receiptBindsApprovalClaims", "customCanonicalBridge"],
      "properties": {
        "module": { "const": "./sdk/runtime.js" },
        "serverModule": { "const": "./sdk/server-runtime.js" },
        "adapterDriven": { "const": true },
        "approvalVerifierRequired": { "const": true },
        "stateModel": { "const": "optimistic-versioned" },
        "receiptBindsApprovalClaims": { "const": true },
        "customCanonicalBridge": { "const": true }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "apiModule", "storeModule", "canonicalStoreModule", "approvalVerifierModule", "atomicStoreRequired", "singleUseCommitCapability", "capabilityBinding", "idempotentReplay", "productionStoreRequirement", "productionStore"],
      "properties": {
        "module": { "const": "./sdk/authority.js" },
        "apiModule": { "const": "./sdk/api-authority.js" },
        "storeModule": { "const": "./sdk/redis-store.js" },
        "canonicalStoreModule": { "const": "./sdk/canonical-store.js" },
        "approvalVerifierModule": { "const": "./sdk/server-approval.js" },
        "atomicStoreRequired": { "const": true },
        "singleUseCommitCapability": { "const": true },
        "capabilityBinding": { "type": "array", "prefixItems": [{ "const": "txId" }, { "const": "planHash" }, { "const": "baseVersion" }, { "const": "humanPrincipal" }, { "const": "agentSession" }], "minItems": 5, "maxItems": 5 },
        "idempotentReplay": { "const": "same-key-only" },
        "productionStoreRequirement": { "type": "string", "minLength": 1 },
        "productionStore": { "type": "string", "minLength": 1 }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "recordModel", "atomicity", "persistentReplayRecords", "crashRecovery", "concurrency", "canonicalReplaySnapshots"],
      "properties": {
        "module": { "const": "./sdk/durable-state.js" },
        "recordModel": { "const": "single-versioned-state-plus-journal" },
        "atomicity": { "const": "compare-and-swap" },
        "persistentReplayRecords": { "const": true },
        "crashRecovery": { "const": "reload-and-validate-journal" },
        "concurrency": { "const": "single-winner-optimistic-transition" },
        "canonicalReplaySnapshots": { "const": true }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restResourceModule", "canonicalBridgeFactory", "adapterFactory", "providerRevision", "conditionalWriteHeader", "idempotencyHeader", "lostResponseRecovery", "credentialsBoundary"],
      "properties": {
        "restResourceModule": { "const": "./sdk/rest-resource.js" },
        "canonicalBridgeFactory": { "const": "createPactRestResourceBridge" },
        "adapterFactory": { "const": "createPactJsonResourceAdapter" },
        "providerRevision": { "const": "etag" },
        "conditionalWriteHeader": { "const": "If-Match" },
        "idempotencyHeader": { "const": "Idempotency-Key" },
        "lostResponseRecovery": { "const": true },
        "credentialsBoundary": { "const": "server-side" }
      }
    },
    "agentBridges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "surfaces", "canonicalOperations", "webmcpHost", "webmcpExecuteCallback", "webmcpRegistrationAbortSignal", "webmcpExecutionAbortSignal", "webmcpUntrustedContentDefault", "mcpTransportOwnedByHost"],
      "properties": {
        "module": { "const": "./sdk/agent-bridge.js" },
        "surfaces": { "type": "array", "prefixItems": [{"const":"http"},{"const":"webmcp"},{"const":"mcp"}], "minItems": 3, "maxItems": 3 },
        "canonicalOperations": { "type": "array", "prefixItems": [{"const":"inspect"},{"const":"preview"},{"const":"approve"},{"const":"commit"},{"const":"verify"},{"const":"receipt"}], "minItems": 6, "maxItems": 6 },
        "webmcpHost": { "const": "document.modelContext" },
        "webmcpExecuteCallback": { "const": "single-input" },
        "webmcpRegistrationAbortSignal": { "const": true },
        "webmcpExecutionAbortSignal": { "const": false },
        "webmcpUntrustedContentDefault": { "const": true },
        "mcpTransportOwnedByHost": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "integrityManifest", "sourceRepository"],
      "properties": {
        "endpoint": { "const": "/release-provenance.json" },
        "integrityManifest": { "const": "/release-manifest.json" },
        "sourceRepository": { "const": "https://github.com/dharan1007/pact" }
      }
    },
    "referenceRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scope", "warning"],
      "properties": {
        "module": { "type": "string" },
        "scope": { "const": "reference-domain-only" },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "security": { "type": "object" },
    "documentation": { "type": "object" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-webmcp.vercel.app/schema/pact-manifest.schema.json",
  "title": "PACT Product Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "kind", "status", "webmcp", "http", "adapterContract", "runtime", "referenceRuntime", "security", "documentation"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "name": { "const": "PACT" },
    "kind": { "const": "transactional-webmcp" },
    "status": { "enum": ["experimental", "preview", "stable"] },
    "webmcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostPreference", "transport", "toolsOnly", "requiresSecureContext"],
      "properties": {
        "hostPreference": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "transport": { "const": "in-page" },
        "toolsOnly": { "type": "boolean" },
        "requiresSecureContext": { "type": "boolean" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorModule", "endpoint", "method", "requestEnvelope", "operations", "idempotencyHeader", "idempotencyRequiredFor"],
      "properties": {
        "connectorModule": { "type": "string" },
        "endpoint": { "type": "string", "pattern": "^/" },
        "method": { "const": "POST" },
        "requestEnvelope": { "type": "object" },
        "operations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "idempotencyHeader": { "const": "Idempotency-Key" },
        "idempotencyRequiredFor": { "type": "array", "uniqueItems": true, "items": { "enum": ["commit", "rollback"] }, "minItems": 2, "maxItems": 2 }
      }
    },
    "adapterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "schema", "requiredMethods", "planModel", "maxEffects", "maxInvariants"],
      "properties": {
        "module": { "const": "./adapter.bundle.js" },
        "schema": { "const": "./schema/pact-adapter.schema.json" },
        "requiredMethods": { "type": "array", "prefixItems": [{"const":"describe"},{"const":"plan"},{"const":"verify"}], "minItems": 3, "maxItems": 3 },
        "planModel": { "const": "declarative-effects-and-invariants" },
        "maxEffects": { "const": 256 },
        "maxInvariants": { "const": 256 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "adapterDriven", "approvalVerifierRequired", "stateModel", "receiptBindsApprovalClaims"],
      "properties": {
        "module": { "const": "./sdk/runtime.js" },
        "adapterDriven": { "const": true },
        "approvalVerifierRequired": { "const": true },
        "stateModel": { "const": "optimistic-versioned" },
        "receiptBindsApprovalClaims": { "const": true }
      }
    },
    "referenceRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "scope", "warning"],
      "properties": {
        "module": { "type": "string" },
        "scope": { "const": "reference-domain-only" },
        "warning": { "type": "string", "minLength": 1 }
      }
    },
    "security": { "type": "object" },
    "documentation": { "type": "object" }
  }
}
